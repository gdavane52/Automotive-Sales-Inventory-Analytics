# Copy this file to .env and set OPENAI_API_KEY.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SQLITE_DB_PATH=data/db/automotive.db
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_RESULT_ROWS=500

LANGGRAPH_RECURSION_LIMIT=16
MAX_SQL_GENERATION_ATTEMPTS=3

# Lightweight session-level demo limits. Not a production or IP-based rate limiter.
MAX_QUESTIONS_PER_SESSION=10
REQUEST_COOLDOWN_SECONDS=5

LOG_LEVEL=INFO

# Include the user question on REQUEST_STARTED / REQUEST_COMPLETED logs.
# Leave unset in shared environments. true | false
OBSERVABILITY_LOG_QUESTION=false

# Include generated SQL on SQL_GENERATION_COMPLETED logs.
# Stored on the request context either way. true | false
OBSERVABILITY_LOG_SQL=false

# LLM metadata (latency, model, token counts) is always logged.
# Prompts and model responses are never written to logs.
OBSERVABILITY_LOG_LLM=false
